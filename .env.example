# ==========================================
# Healthcare Management Backend Environment
# ==========================================

# Django Security
# Generate a secure key in production (e.g. python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=django-insecure-change-me-in-production

# Debug Mode: True for development, False for production
DEBUG=True

# Allowed Hosts: Comma-separated hostnames or IP addresses
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Database Configuration (PostgreSQL)
# All credentials below are strictly required without defaults.
DB_NAME=healthcare_db
DB_USER=healthcare_admin
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432

# Automated Testing Configuration (PostgreSQL-First)
# By default, 'python manage.py test' runs against isolated PostgreSQL using healthcare_test_db.
# Optional: Set USE_SQLITE_TEST_DB=True to explicitly opt into in-memory SQLite for fast local unit tests.
USE_SQLITE_TEST_DB=False
TEST_DB_NAME=healthcare_test_db
